# ─────────────────────────────────────────────────────────────
# AI GitHub Project Reviewer — Environment Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored and must NEVER be committed.
#
#   cp backend/.env.example backend/.env
#
# ─────────────────────────────────────────────────────────────

# ── GitHub Personal Access Token (required) ──────────────────
# Used to call the GitHub REST API v3.
# Create one at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only is sufficient)
# Without this token you are limited to 60 unauthenticated
# requests/hour; with it you get 5 000 requests/hour.
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Google Gemini API Key (required for AI review) ───────────
# Used for the Gemini AI code-review step.
# Get a free key at: https://aistudio.google.com/app/apikey
# If missing or invalid the app still works — the AI section
# falls back to a static placeholder and sets ai_available=false.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (optional — SQLite default is fine locally) ─────
# Default creates github_reviewer.db in the backend/ directory.
# For PostgreSQL use: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./github_reviewer.db

# ── Analysis limits (optional) ───────────────────────────────
# Maximum file size (KB) to download and analyze per file.
MAX_FILE_SIZE_KB=150
# Maximum number of source files to analyze per repository.
MAX_FILES_TO_ANALYZE=20

# ── CORS allowed origins (optional) ─────────────────────────
# Comma-separated list of frontend origins the backend accepts.
# Supports wildcards for Vercel preview URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app
